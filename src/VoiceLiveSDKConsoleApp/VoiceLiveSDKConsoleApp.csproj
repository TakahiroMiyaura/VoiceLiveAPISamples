<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Com.Reseul.Azure.AI.Samples.VoiceLiveSDKConsoleApp</AssemblyName>
    <RootNamespace>Com.Reseul.Azure.AI.Samples.VoiceLiveSDK</RootNamespace>
    <UserSecretsId>4a5e5543-c24c-43fc-a474-4eedbb89283b</UserSecretsId>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>pre.1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\VoiceLiveAPISamplesLocal\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Sample image for the 'I' (send image) command, copied next to the executable. -->
  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.VoiceLive" Version="1.1.0" />
    <!-- Azure.Identity 参照は削除: Azure.Core 1.57.0 が DefaultAzureCredential 等の credential 型を取り込んだため、
         Azure.Identity 1.14.2 を併用すると Azure.Identity.DefaultAzureCredential が二重定義され CS0433 衝突する。
         必要な DefaultAzureCredential は Azure.Core (SDK 経由で 1.57.0 が推移的に解決) から供給される。 -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.9" />
    <PackageReference Include="FFMpegCore" Version="5.1.0" />
    <PackageReference Include="CliWrap" Version="3.6.6" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceLiveAPI.Avatars\VoiceLiveAPI.Avatars.csproj" />
    <ProjectReference Include="..\VoiceLiveAPI.Avatars.Streaming\VoiceLiveAPI.Avatars.Streaming.csproj" />
  </ItemGroup>

</Project>
