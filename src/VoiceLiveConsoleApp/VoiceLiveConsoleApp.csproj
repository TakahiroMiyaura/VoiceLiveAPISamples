<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- Matches VoiceLiveAPI.WebRtcAudio (SIPSorceryMedia.Windows targets net8.0-windows10.0.17763). -->
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Com.Reseul.Azure.AI.Samples.VoiceLiveConsoleApp</AssemblyName>
		<RootNamespace>Com.Reseul.Azure.AI.Samples.VoiceLiveAPI</RootNamespace>
		<UserSecretsId>4a5e5543-c24c-43fc-a474-4eedbb89283b</UserSecretsId>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<VersionPrefix>1.0.0</VersionPrefix>
		<VersionSuffix>pre.2</VersionSuffix>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>full</DebugType>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\..\VoiceLiveAPISamplesLocal\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.9" />
		<!-- Azure.Identity 参照は削除: Core 経由で解決される Azure.Core 1.57.0 が DefaultAzureCredential を提供し、
		     Azure.Identity 1.14.2 併用時は Azure.Identity.DefaultAzureCredential が二重定義され CS0433 衝突するため。
		     使用している TokenRequestContext / AccessToken は元来 Azure.Core の型。 -->
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
		<PackageReference Include="FFMpegCore" Version="5.1.0" />
		<PackageReference Include="CliWrap" Version="3.6.6" />
		<PackageReference Include="Concentus" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VoiceLiveAPI.Avatars\VoiceLiveAPI.Avatars.csproj" />
		<ProjectReference Include="..\VoiceLiveAPI.Avatars.Streaming\VoiceLiveAPI.Avatars.Streaming.csproj" />
		<ProjectReference Include="..\VoiceLiveAPI.Core\VoiceLiveAPI.Core.csproj" />
		<ProjectReference Include="..\VoiceLiveAPI.WebRtcAudio\VoiceLiveAPI.WebRtcAudio.csproj" />
	</ItemGroup>

</Project>